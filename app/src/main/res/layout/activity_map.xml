<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ============================================= -->
    <!-- GOOGLE MAP -->
    <!-- ============================================= -->

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <!-- ============================================= -->
    <!-- BACK -->
    <!-- ============================================= -->

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="43dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:gravity="center"
        android:text="←"
        android:textColor="#222222"
        android:textSize="26sp" />


    <!-- ============================================= -->
    <!-- NHẬP ĐỊA CHỈ -->
    <!-- ============================================= -->

    <EditText
        android:id="@+id/edtSearchAddress"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="76dp"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="16dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:hint="Nhập địa chỉ giao hàng..."
        android:imeOptions="actionSearch"
        android:inputType="textPostalAddress"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#222222"
        android:textColorHint="#888888"
        android:textSize="14sp" />


    <!-- ============================================= -->
    <!-- PANEL DƯỚI -->
    <!-- ============================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">


        <!-- LABEL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Địa chỉ giao hàng"
            android:textColor="#777777"
            android:textSize="13sp" />


        <!-- ĐỊA CHỈ ĐÃ TÌM -->

        <TextView
            android:id="@+id/txtSelectedAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Chưa chọn địa chỉ"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- HƯỚNG DẪN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nhập địa chỉ phía trên và nhấn Search để tìm vị trí."
            android:textColor="#888888"
            android:textSize="13sp" />


        <!-- CONFIRM -->

        <Button
            android:id="@+id/btnConfirmAddress"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#65869D"
            android:text="XÁC NHẬN ĐỊA CHỈ"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>